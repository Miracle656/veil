{
  "name": "veil",
  "private": true,
  "description": "Root scripts — smoke tests and tooling for Veil",
  "scripts": {
    "smoke": "npx ts-node scripts/smoke_test.ts",
    "release-notes": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-package-lockfiles.mjs",
    "release": "changeset publish",
    "verify:lockfile": "node scripts/verify-root-lockfile.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.0.0",
    "conventional-changelog-cli": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
