# SPP Bootnode — Environment Variables
# Copy to .env and fill in your values.

# ── Core ──────────────────────────────────────────────────────────────────────

# HTTP port the service listens on.
PORT=3002

# Soroban RPC endpoint to poll for pool events.
RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase (must match RPC_URL's network).
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Pool addresses ────────────────────────────────────────────────────────────

# Comma-separated list of SPP pool contract addresses to index.
# Defaults to Nethermind's testnet XLM pool if unset.
# See: NethermindEth/stellar-private-payments/deployments/testnet
POOL_ADDRESSES=CD3LA6RKF5D2FN2R2L57MWXLBRSEWWENE74YBEFZSSGNJRJGICFGQXMX

# ── Indexer tuning ────────────────────────────────────────────────────────────

# How often to poll the RPC for new events, in milliseconds.
# Default: 30000 (30 s). A Stellar ledger closes every ~5 s, so 30 s gives
# ≤ 6 ledgers lag (~30 s) — acceptable for note discovery.
POLL_INTERVAL_MS=30000

# Events per getEvents page (max 200 per Soroban RPC spec).
PAGE_SIZE=200

# ── Storage ───────────────────────────────────────────────────────────────────

# Path to the SQLite database file.
# The parent directory is created automatically on first run.
DB_PATH=./data/bootnode.db

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated origins allowed to call /events.
# Leave blank to allow all origins (suitable for testnet / local dev).
# Production: restrict to the wallet and mobile proxy origins.
ALLOWED_ORIGINS=https://app.useveilapp.xyz,http://localhost:3000
