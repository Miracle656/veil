# Expo Push Sender Service — Environment Variables
# Copy to .env and fill in your values.

# Port for the HTTP server (health check + admin routes)
PORT=3003

# Required bearer token protecting all /admin/* routes
PUSH_ADMIN_TOKEN=your-push-admin-token-here

# Optional: Expo Access Token from your Expo/EAS account dashboard
# (Enables Expo Push Security so only authorized callers can push to your project's tokens)
EXPO_ACCESS_TOKEN=

# Persistent JSON store file path (atomic writes)
PUSH_STORE_PATH=./data/push-store.json

# Interval in ms for background receipt polling (default: 60,000 ms)
RECEIPT_POLL_INTERVAL_MS=60000
