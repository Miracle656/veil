# Repo-level examples

# Wallet frontend
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_FACTORY_CONTRACT_ID=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA
NEXT_PUBLIC_FACTORY_CONTRACT_ID_TESTNET=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA
NEXT_PUBLIC_FACTORY_CONTRACT_ID_MAINNET=CCZ3JLRESNLDADGXWNEH4YQ4NXUUAHRJNCWZHYG6QB4KTDYHOH6OQ7BK
NEXT_PUBLIC_VAULT_WASM_HASH=
NEXT_PUBLIC_VAULT_WASM_HASH_TESTNET=
NEXT_PUBLIC_VAULT_WASM_HASH_MAINNET=
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Required for mainnet wallet builds. Use your provider endpoint from
# Blockdaemon, Validation Cloud, QuickNode, or your own RPC deployment.
NEXT_PUBLIC_MAINNET_RPC_URL=

# Mobile app (Expo)
EXPO_PUBLIC_WRAITH_URL=http://localhost:3001
EXPO_PUBLIC_DEMO_ADDRESS=GB...  # A Stellar testnet address for demoing the activity feed

# Demo app (legacy env names)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_FACTORY_ADDRESS=         # output of scripts/deploy_factory.sh

# Wraith indexer, used by the activity feed and the CAP-46 NFT gallery.
# Leave blank to run without one: the feed falls back to Horizon, and the NFT
# gallery says it has no indexer rather than showing an empty wallet.
NEXT_PUBLIC_WRAITH_URL=
# Render demonstration NFTs in the gallery (1 = on). Off everywhere real.
NEXT_PUBLIC_NFT_FIXTURES=0

# Used by scripts (Node.js — no NEXT_PUBLIC_ prefix)
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FACTORY_ADDRESS=                     # same value as above
