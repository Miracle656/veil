# Veil Wallet — Environment Variables
# Copy to .env.local and fill in your values

# Active wallet network (testnet | mainnet)
NEXT_PUBLIC_NETWORK=testnet

# Factory contract IDs. Both networks have working defaults compiled into
# lib/network.ts, so a fresh clone runs with none of these set — override only
# to point at your own factory deployment.
#
# Testnet factory contract ID.
# Kept for backwards compatibility with older local setups.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA

# Preferred explicit per-network factory contract IDs.
NEXT_PUBLIC_FACTORY_CONTRACT_ID_TESTNET=CAUK4MWO3TTFM6PLURSH2GPK3AB747SZGABKTCVLKCU7W2MGKHKP35GA
NEXT_PUBLIC_FACTORY_CONTRACT_ID_MAINNET=CCZ3JLRESNLDADGXWNEH4YQ4NXUUAHRJNCWZHYG6QB4KTDYHOH6OQ7BK

# Vault contract WASM hashes. Required only when creating a new vault from the UI.
# You can still attach and manage an existing vault without these.
NEXT_PUBLIC_VAULT_WASM_HASH=
NEXT_PUBLIC_VAULT_WASM_HASH_TESTNET=
NEXT_PUBLIC_VAULT_WASM_HASH_MAINNET=

# DAO multisig contract WASM hashes, per network (issue #672).
#
# A WASM hash only means something on the network the bytecode was installed
# on, so there is one variable per network and no shared fallback. Whether
# /multisig is reachable at all is decided by these: a network with no hash
# has no multisig route, because the deploy could only fail at the signature.
#
# Testnet has a verified default compiled into lib/multisigConfig.ts
# (7eb63568…, confirmed installed on testnet), so leave this blank unless you
# installed your own build.
NEXT_PUBLIC_MULTISIG_WASM_HASH_TESTNET=
# Mainnet has NO default: the multisig contract is not installed on mainnet as
# of 2026-09-02, so /multisig is gated off there. Set this only after actually
# installing the WASM on mainnet — a hash that is not on-chain re-creates the
# exact failure #672 describes.
NEXT_PUBLIC_MULTISIG_WASM_HASH_MAINNET=

# Optional testnet endpoint overrides.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Mainnet Soroban RPC endpoint.
# Required when NEXT_PUBLIC_NETWORK=mainnet because Stellar does not provide a
# public Soroban RPC for mainnet. Use your provider endpoint from Blockdaemon,
# Validation Cloud, QuickNode, or a self-hosted RPC service.
NEXT_PUBLIC_MAINNET_RPC_URL=

# Mainnet Soroban RPC endpoint, SERVER-SIDE (no NEXT_PUBLIC_ prefix).
# Preferred over NEXT_PUBLIC_MAINNET_RPC_URL for anything deployed publicly:
# the wallet proxies mainnet RPC through /api/rpc/mainnet so the provider key
# never reaches the browser. Without this set, the UI keeps mainnet disabled.
MAINNET_RPC_URL=

# WalletConnect Cloud project ID
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Agent WebSocket server
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:3001

# Transak API key for the buy-crypto fiat onramp (issue #117)
# Apply at https://partners.transak.com — free for dev/testnet usage
# If omitted, Transak widget opens without an API key (limited mode)
NEXT_PUBLIC_TRANSAK_API_KEY=

# Wraith indexer base URL — the activity feed and the CAP-46 NFT gallery both
# read from it. Point it at your own deployment; leaving it blank is supported
# and the gallery will say so rather than render an empty wallet.
NEXT_PUBLIC_WRAITH_URL=

# Explicit opt-in for the gallery's demonstration NFTs (1 = on, default off).
# Never enable in a deployment a real user can reach: the items are invented.
NEXT_PUBLIC_NFT_FIXTURES=0
