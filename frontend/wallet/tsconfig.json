{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "jest"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@veil/sdk": [
        "../../sdk/dist/index"
      ],
      "@veil/agent-core": [
        "../../packages/agent/src/handler"
      ],
      "@veil/agent-llm": [
        "../../packages/agent/src/llm"
      ],
      "@veil/agent-review": [
        "../mobile/lib/agentMessages"
      ],
      "@veil/events": [
        "../../sdk/dist/events"
      ],
      "@veil/utils": [
        "../../sdk/dist/utils"
      ],
      "@veil/recovery": [
        "../../sdk/dist/recovery/sep30"
      ],
      "@veil/backup": [
        "../../sdk/dist/backup"
      ],
      "@veil/prf": [
        "../../sdk/dist/crypto/prf"
      ],
      "@veil/sep7": [
        "../../sdk/dist/sep7"
      ],
      "@veil/dapps": [
        "../mobile/lib/dappAllowlist"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@anthropic-ai/sdk": [
        "./node_modules/@anthropic-ai/sdk"
      ],
      "@soroswap/sdk": [
        "./node_modules/@soroswap/sdk"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
