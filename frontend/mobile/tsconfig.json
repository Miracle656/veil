{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@veil/sdk": [
        "../../sdk/src/useInvisibleWallet"
      ],
      "react": ["./node_modules/@types/react"],
      "@stellar/stellar-sdk": ["./node_modules/@stellar/stellar-sdk"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
