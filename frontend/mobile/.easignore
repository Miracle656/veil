# What NOT to upload to EAS Build.
#
# EAS normally derives the upload from git. With EAS_NO_VCS=1 it walks the
# filesystem instead, and then this file is the only thing standing between a
# 5.8 MB upload and a multi-gigabyte one — so it has to name everything git
# would otherwise have excluded.
#
# The no-VCS path exists because spawning git during a build request fails on a
# memory-constrained Windows machine (`git status` exits 3221225794, a DLL
# initialisation failure, not a repository problem).

node_modules/
.expo/
.expo-shared/
dist/
web-build/

# Native projects are generated by prebuild on the build server. Uploading a
# local copy is how a stale android/ directory silently overrides app.config.ts.
android/
ios/

# Local secrets. EXPO_PUBLIC_ values reach the bundle through the build profile
# and EAS environment variables, never by shipping this file.
.env
.env.*
!.env.example

# Test and tooling output, none of which the build needs.
coverage/
.maestro/
**/__tests__/
**/*.test.ts
**/*.test.tsx
.jest-cache/

# Editor and OS noise.
.DS_Store
*.log
.idea/
.vscode/
