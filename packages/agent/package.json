{
  "name": "@veil/agent",
  "version": "0.2.0",
  "private": true,
  "description": "Veil AI agent — wallet assistant that proposes Stellar transactions for passkey approval",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./assets": {
      "import": "./dist/assets.js",
      "types": "./dist/assets.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs"
  },
  "keywords": [
    "stellar",
    "soroban",
    "ai-agent",
    "claude",
    "veil"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@soroswap/sdk": "^0.5.0",
    "@stellar/stellar-sdk": "^16.4.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
