{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "declaration": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "*.native.ts",
        "*.test.ts",
        "src/examples"
    ]
}