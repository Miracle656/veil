{
  "name": "invisible-wallet-sdk",
  "version": "0.1.0",
  "description": "Client SDK for Invisible Wallet (Soroban + WebAuthn) — supports Web and React Native",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "react-native": "./src/vanilla.ts",
      "default": "./dist/vanilla.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vue"
  ],
  "scripts": {
    "build": "tsc && node scripts/flatten-dist.js",
    "test": "jest",
    "test:vitest": "vitest run --coverage",
    "size": "npm run build && size-limit",
    "test:surface": "jest api-surface.test.ts",
    "stryker": "stryker run",
    "storybook": "storybook dev -p 6006 -c react/.storybook",
    "build-storybook": "storybook build -c react/.storybook -o react/storybook-static",
    "test-d": "npm run build && tsd"
  },
  "keywords": [
    "stellar",
    "soroban",
    "webauthn",
    "passkeys",
    "wallet",
    "react-native",
    "expo",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-passkey": ">=3.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-passkey": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/jest-runner": "^8.7.0",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.3.0",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-util": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^12.1.0",
    "storybook": "^8.6.0",
    "ts-jest": "^29.2.0",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.11",
    "vitest": "^1.3.0",
    "vue": "^3.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx",
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@stellar/stellar-sdk$": "<rootDir>/node_modules/@stellar/stellar-sdk"
    },
    "globals": {
      "ts-jest": {
        "isolatedModules": true,
        "diagnostics": false,
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "resolveJsonModule": true,
          "ignoreDeprecations": "6.0"
        }
      }
    }
  },
  "size-limit": [
    {
      "name": "main (React hook + utils)",
      "path": "dist/index.js",
      "limit": "230 KB"
    },
    {
      "name": "vanilla",
      "path": "dist/vanilla.js",
      "limit": "225 KB"
    }
  ],
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "jsx": "react-jsx",
      "lib": [
        "es2020",
        "dom"
      ]
    }
  }
}
