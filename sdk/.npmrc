# sdk/ installs standalone (the repo root is not an npm workspace — see #670 and
# CONTRIBUTING.md), so npm reads this file and not anything above it.
#
# The SDK's dev tooling carries two peer conflicts that predate this file:
#   @stryker-mutator/typescript-checker@9 wants @stryker-mutator/core@9, pinned at ^8.7
#   @types/react@18 against the @types/react-dom@19 that Storybook 8 pulls in
# Neither affects the shipped bundle. Resolve them the way CI already does so a
# plain `npm install` here works on a fresh clone.
legacy-peer-deps=true
