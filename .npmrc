# Monorepo-wide install config. `sdk` and `packages/*` are npm workspaces, so
# npm resolves them from this root and reads this file. The SDK dev-depends on
# react@^18 while react-dom resolves to 19 (and Storybook widens the peer) — a
# pre-existing peer mismatch on main. Allow installs to proceed deterministically.
legacy-peer-deps=true
