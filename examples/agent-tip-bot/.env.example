# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Session key — a funded Stellar testnet keypair used to sign tip payments.
# Fund it at https://laboratory.stellar.org/#account-creator?network=test
SESSION_KEY_SECRET=S...

# Spend cap: maximum total XLM this bot may tip per run (default: 10)
SPEND_CAP_XLM=10

# Score threshold: only tip posts scoring at or above this value (0–100, default: 70)
SCORE_THRESHOLD=70

# Tip amount in XLM per qualifying post (default: 1)
TIP_AMOUNT_XLM=1

# Stellar network: testnet (default) or mainnet
STELLAR_NETWORK=testnet

# Optional: override Horizon and Soroban RPC URLs
# HORIZON_URL=https://horizon-testnet.stellar.org
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
