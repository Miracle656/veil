# Deployed factory contract that mints wallet instances. Required.
VITE_FACTORY_ADDRESS=

# Stellar testnet defaults — override for mainnet or a local quickstart node.
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Funds the throwaway fee-payer account. Leave empty on mainnet and fund it yourself.
VITE_FRIENDBOT_URL=https://friendbot.stellar.org

VITE_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
