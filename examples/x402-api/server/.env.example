# ── x402 resource + facilitator server ───────────────────────────────────────

# Stellar secret (S…) the facilitator uses to settle and fee-bump the client's
# payment on-chain. On testnet, create one and fund it from Friendbot:
#   https://friendbot.stellar.org/?addr=<G...>
# REQUIRED — the server exits on startup if this is unset.
FACILITATOR_SECRET=

# Public key (G…) that receives the 0.01 XLM. Defaults to the facilitator's own
# account when left blank, so a single funded key is enough to run the demo.
PAY_TO=

# Network: testnet (default) or mainnet.
STELLAR_NETWORK=testnet

# Soroban RPC endpoint.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# HTTP port and the browser origin allowed to call the API (the Next.js client).
PORT=4021
ALLOWED_ORIGIN=http://localhost:3000
