# Optional overrides for the QR POS example. Defaults target Stellar testnet.

# Horizon endpoint to poll for incoming payments.
VITE_HORIZON_URL=

# SEP-7 network passphrase embedded in the pay request.
VITE_NETWORK_PASSPHRASE=

# Pre-fill the merchant's receiving account (G…). Leave blank to type it in.
VITE_MERCHANT_ADDRESS=
